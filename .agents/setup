#!/usr/bin/env bash
set -euo pipefail

step() {
  local label=$1
  shift
  printf '==> %s\n' "$label"
  time "$@"
}

ensure_installer_dependencies() {
  local packages=(ca-certificates curl xz-utils)
  local missing=()
  local package

  for package in "${packages[@]}"; do
    dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null | grep -q '^ii ' || missing+=("$package")
  done

  if ((${#missing[@]})); then
    sudo apt-get update
    sudo apt-get install -y "${missing[@]}"
  fi
}

install_nix() {
  if [[ -x "$HOME/.nix-profile/bin/nix" ]]; then
    return
  fi

  local installer
  installer=$(mktemp)
  curl --fail --location --silent --show-error https://nixos.org/nix/install --output "$installer"
  if ! bash "$installer" --no-daemon --yes; then
    rm -f "$installer"
    return 1
  fi
  rm -f "$installer"
}

configure_nix() {
  local nix_profile="$HOME/.nix-profile"
  local profile_marker='# nixos-config Nix environment'

  # The installer cannot update this running process.
  # shellcheck disable=SC1091
  source "$nix_profile/etc/profile.d/nix.sh"

  mkdir -p "$HOME/.config/nix"
  if ! grep -Eq '^[[:space:]]*(extra-)?experimental-features[[:space:]]*=.*(^|[[:space:]])flakes([[:space:]]|$)' "$HOME/.config/nix/nix.conf" 2>/dev/null; then
    printf '%s\n' 'extra-experimental-features = nix-command flakes' >> "$HOME/.config/nix/nix.conf"
  fi

  if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<'EOF'

# nixos-config Nix environment
if [ -e "$HOME/.nix-profile/etc/profile.d/nix.sh" ]; then
  . "$HOME/.nix-profile/etc/profile.d/nix.sh"
fi
EOF
  fi
}

warm_flake_inputs() {
  "$HOME/.nix-profile/bin/nix" flake metadata --no-write-lock-file . >/dev/null
}

step 'Checking Nix installer dependencies' ensure_installer_dependencies
step 'Installing Nix when missing' install_nix
step 'Configuring Nix for login shells and flakes' configure_nix
step 'Fetching pinned flake inputs' warm_flake_inputs

printf 'Orb setup complete.\n'
