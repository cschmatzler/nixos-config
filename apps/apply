#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

read -r host kind < <(resolve_local_host)
apply_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --show-trace | --print-build-logs | -L | --verbose | -v | --quiet | --keep-going | -k)
      apply_args+=("$1")
      shift
      ;;
    --max-jobs | -j | --cores)
      if [[ $# -lt 2 || ! "$2" =~ ^([0-9]+|auto)$ ]]; then
        print_error "$1 requires a non-negative number or auto"
        exit 1
      fi
      apply_args+=("$1" "$2")
      shift 2
      ;;
    --max-jobs=* | --cores=*)
      value="${1#*=}"
      if [[ ! "$value" =~ ^([0-9]+|auto)$ ]]; then
        print_error "${1%%=*} requires a non-negative number or auto"
        exit 1
      fi
      apply_args+=("$1")
      shift
      ;;
    *)
      print_error "Unsupported apply argument: $1"
      exit 1
      ;;
  esac
done

print_info "Applying configuration for $host"

if [[ "$kind" == "darwin" ]]; then
  run_as_root darwin-rebuild switch --flake ".#${host}" "${apply_args[@]}"
else
  run_as_root nixos-rebuild switch --flake ".#${host}" "${apply_args[@]}"
fi

print_success "Configuration applied successfully"
