#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

requested_host=""
build_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)
      if [[ $# -lt 2 || -z "$2" ]]; then
        print_error "--host requires a Host name"
        exit 1
      fi
      requested_host="$2"
      shift 2
      ;;
    --)
      shift
      build_args=("$@")
      break
      ;;
    *)
      print_error "Unknown build argument: $1"
      exit 1
      ;;
  esac
done

host="$(resolve_host "$requested_host")"
kind="$(require_host_kind "$host")"

print_info "Building configuration for $host"

if [[ "$kind" == "darwin" ]]; then
  target=".#darwinConfigurations.${host}.system"
else
  target=".#nixosConfigurations.${host}.config.system.build.toplevel"
fi

nix build "$target" --show-trace "${build_args[@]}"

if [[ -e ./result || -L ./result ]]; then
  rm ./result
fi

print_success "Build completed successfully"
