#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

if [[ $# -eq 0 ]]; then
  print_info "Updating all flake inputs"
  nix flake update
else
  print_info "Updating flake inputs: $*"
  nix flake update "$@"
fi

print_info "Regenerating flake.nix"
nix run .#write-flake

print_success "Flake updated"
