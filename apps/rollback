#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

generation=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --generation)
      if [[ $# -lt 2 ]]; then
        print_error "--generation requires a positive generation number"
        exit 1
      fi
      if [[ ! "$2" =~ ^[1-9][0-9]*$ ]]; then
        print_error "--generation requires a positive generation number"
        exit 1
      fi
      generation="$2"
      shift 2
      ;;
    *)
      print_error "Unknown rollback argument: $1"
      exit 1
      ;;
  esac
done

if [[ -z "$generation" ]]; then
  print_error "rollback requires --generation NUMBER"
  exit 1
fi

host="$(resolve_local_host)"

print_warning "Rolling back $host to generation $generation"
rollback_local_host "$host" "$generation"
print_success "Rollback to generation $generation complete"
