#!/bin/bash
set -euo pipefail

case "${1:-}" in
  prepare)
    [[ "$#" -eq 1 ]]
    uid="$(/usr/bin/id -u agent)"
    gid="$(/usr/bin/id -g agent)"
    host_system="$(/usr/bin/readlink -f /nix/var/nix/profiles/system)"
    [[ "$host_system" =~ ^/nix/store/[a-z0-9]{32}-[^/]+$ ]]

    runtime_dir="/run/user/$uid"
    /usr/bin/mkdir -p "$runtime_dir" /run/wrappers/bin
    /usr/bin/chown "$uid:$gid" "$runtime_dir"
    /usr/bin/chmod 0700 "$runtime_dir"
    /usr/bin/ln -sfn "$host_system" /run/current-system
    /usr/bin/ln -sfn /home/agent/.local/bin/herdr-sandbox-sudo /run/wrappers/bin/sudo

    hosts=/run/herdr-sandbox-hosts
    /usr/bin/cp /etc/hosts "$hosts.new"
    if ! /usr/bin/grep -qE '^[^#]*[[:space:]]herdr-sandbox([[:space:]]|$)' "$hosts.new"; then
      printf '127.0.1.1 herdr-sandbox\n' >>"$hosts.new"
    fi
    /usr/bin/mv "$hosts.new" "$hosts"
    /usr/bin/mountpoint -q /etc/hosts || /usr/bin/mount --bind "$hosts" /etc/hosts
    /usr/bin/hostname herdr-sandbox
    ;;
  overcommit)
    [[ "$#" -eq 1 ]]
    /usr/sbin/sysctl -q -w vm.overcommit_memory=1
    ;;
  *)
    echo "unsupported sandbox root operation" >&2
    exit 64
    ;;
esac
