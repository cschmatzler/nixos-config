#!/usr/bin/env fish

if test (basename (status filename)) = aube
    set -l real_aube /home/agent/workspace/.devenv/profile/bin/aube
    if test "$argv[1]" = install; and test -x "$real_aube"; and \
            env -C /home/agent/workspace "$real_aube" check >/dev/null 2>&1
        echo "aube cache reused · ✓ Already up to date"
        exit 0
    end
    exec "$real_aube" $argv
end

set -l mode "$argv[1]"
if test -z "$mode"
    set mode attach
end
if not contains -- "$mode" attach prepare provision-locked
    echo "[herdr-sandbox] invalid guest shell mode" >&2
    exit 2
end

set -gx HOME /home/agent
ln -sfn "$HERDR_HOST_PROFILE" "$HOME/.nix-profile"
set -gx PATH (dirname "$HERDR_NIX") "$HOME/.nix-profile/bin" $PATH
set -gx PI_SKIP_VERSION_CHECK 1
set -gx DEVENV_TUI false
set -gx BROWSER none
set -gx HTTP_PROXY "http://127.0.0.1:$HERDR_SANDBOX_EGRESS_PORT"
set -gx HTTPS_PROXY "$HTTP_PROXY"
set -gx http_proxy "$HTTP_PROXY"
set -gx https_proxy "$HTTP_PROXY"
set -gx NO_PROXY 127.0.0.1,localhost
set -gx no_proxy "$NO_PROXY"
set -gx GH_TOKEN "$HERDR_SANDBOX_CREDENTIAL_TOKEN"
set -gx SUPERMEMORY_API_KEY "$HERDR_SANDBOX_CREDENTIAL_TOKEN"
set -gx SUPERMEMORY_BASE_URL "http://127.0.0.1:$HERDR_SANDBOX_EGRESS_PORT/supermemory"

set -l state_dir "$HOME/.local/state/herdr-sandbox"
set -l canonical_workspace /home/agent/workspace
mkdir -p "$state_dir" "$HOME/.docker"
set -l docker_proxy "http://172.17.0.1:$HERDR_SANDBOX_EGRESS_PORT"
printf '{"proxies":{"default":{"httpProxy":"%s","httpsProxy":"%s","noProxy":"%s"}}}\n' \
    "$docker_proxy" "$docker_proxy" "127.0.0.1,localhost" >"$HOME/.docker/config.json"

set -l proxy_ca "$state_dir/proxy-ca.crt"
set -l proxy_ca_bundle "$state_dir/proxy-ca-bundle.pem"
if not test -r "$proxy_ca"
    echo "[herdr-sandbox] egress proxy CA is unavailable" >&2
    exit 1
end
if not test -r "$proxy_ca_bundle"; or test "$proxy_ca" -nt "$proxy_ca_bundle"
    set -l temporary_ca_bundle "$proxy_ca_bundle."(random)
    cat /etc/ssl/certs/ca-certificates.crt "$proxy_ca" >"$temporary_ca_bundle"; or exit 1
    chmod 600 "$temporary_ca_bundle"
    mv -f "$temporary_ca_bundle" "$proxy_ca_bundle"
end
set -gx SSL_CERT_FILE "$proxy_ca_bundle"
set -gx NIX_SSL_CERT_FILE "$proxy_ca_bundle"
set -gx NODE_EXTRA_CA_CERTS "$proxy_ca_bundle"

# Mirror immutable Home Manager files only when the generation changes.
if test -d "$HERDR_HOST_HOME_FILES"; and test "$HERDR_HOST_HOME_FILES" != "$(cat $state_dir/home-files 2>/dev/null)"
    for relative in (find "$HERDR_HOST_HOME_FILES" -mindepth 1 -not -type d -printf '%P\0' | string split0)
        set -l target "$HOME/$relative"
        mkdir -p (dirname "$target")
        ln -sfn "$HERDR_HOST_HOME_FILES/$relative" "$target"
    end
    printf '%s' "$HERDR_HOST_HOME_FILES" >"$state_dir/home-files"
end

rm -f "$HOME/.config/gh/hosts.yml"
mkdir -p "$HOME/.pi/agent" "$HOME/.config/herdr"
if test -d /run/herdr/cache/nix-host; and not test -e "$state_dir/nix-cache-seeded"
    mkdir -p "$HOME/.cache/nix"
    cp -a /run/herdr/cache/nix-host/. "$HOME/.cache/nix/"
    chmod -R u+w "$HOME/.cache/nix"
    find "$HOME/.cache/nix" -type f \
        \( -name '*.sqlite-journal' -o -name '*.sqlite-shm' -o -name '*.sqlite-wal' \) \
        -delete
    touch "$state_dir/nix-cache-seeded"
end
for cache in .pi/agent/npm .pi/agent/git
    set -l source "$HERDR_HOST_HOME/$cache"
    set -l target "$HOME/$cache"
    if test -d "$source"; and not test -e "$target"
        mkdir -p (dirname "$target")
        ln -s "$source" "$target"
    end
end

set -gx HERDR_SOCKET_PATH "$HOME/.config/herdr/herdr.sock"
set -gx HERDR_SANDBOX_TOKEN_FILE "$state_dir/capability"
set -gx HERDR_SANDBOX_BRIDGE_URL "http://127.0.0.1:$HERDR_SANDBOX_BROKER_PORT"
if test "$mode" = attach
    set -l relay_state "$state_dir/relay"
    mkdir -p "$relay_state"
    set -l relay_pid (cat "$relay_state/pid" 2>/dev/null)
    set -l capability (cat "$HERDR_SANDBOX_TOKEN_FILE" 2>/dev/null)
    set -l relay_capability (cat "$relay_state/capability" 2>/dev/null)
    if not string match -qr '^[a-f0-9]{64}$' -- "$capability"
        echo "[herdr-sandbox] workspace capability is unavailable" >&2
        exit 1
    end
    if test "$relay_capability" != "$capability"; or not kill -0 "$relay_pid" 2>/dev/null
        kill "$relay_pid" 2>/dev/null
        printf '%s' "$capability" >"$relay_state/capability"
        chmod 600 "$relay_state/capability"
        rm -f "$HERDR_SOCKET_PATH"
        nohup node "$HOME/.local/lib/herdr-sandbox/herdr-relay.mjs" \
            >"$relay_state/log" 2>&1 &
        echo $last_pid >"$relay_state/pid"
    end
end

if test -d "$HERDR_HOST_HOME/.cache/ms-playwright"; and \
        test "$HERDR_HOST_HOME/.cache/ms-playwright" != "$(cat $state_dir/playwright-source 2>/dev/null)"
    set -gx PLAYWRIGHT_BROWSERS_PATH "$HOME/.cache/ms-playwright"
    set -gx PLAYWRIGHT_SKIP_BROWSER_GC 1
    mkdir -p "$PLAYWRIGHT_BROWSERS_PATH"
    for browser in "$HERDR_HOST_HOME/.cache/ms-playwright"/*
        set -l target "$PLAYWRIGHT_BROWSERS_PATH/"(basename "$browser")
        test -e "$target"; or ln -s "$browser" "$target"
    end
    printf '%s' "$HERDR_HOST_HOME/.cache/ms-playwright" >"$state_dir/playwright-source"
else if test -d "$HOME/.cache/ms-playwright"
    set -gx PLAYWRIGHT_BROWSERS_PATH "$HOME/.cache/ms-playwright"
    set -gx PLAYWRIGHT_SKIP_BROWSER_GC 1
end

if test "$mode" = provision-locked
    cd "$canonical_workspace"; or exit 1
    set -l imported_manifest "$state_dir/imported-cache.json"
    if test -r "$imported_manifest"
        "$HOME/.nix-profile/bin/jq" -e \
            --arg devenv "$HERDR_DEVENV_CACHE_FINGERPRINT" \
            --arg dependencies "$HERDR_DEPENDENCY_CACHE_FINGERPRINT" \
            '.devenv == $devenv and .dependencies == $dependencies' \
            "$imported_manifest" >/dev/null 2>&1
        or rm -f "$imported_manifest"
    end
    if test -r "$imported_manifest"
        if not test -d .devenv; or not test -d node_modules; or \
                not test -x .devenv/profile/bin/aube
            rm -rf .devenv
            find . -maxdepth 3 -name node_modules -type d -prune -exec rm -rf -- {} +
            rm -f "$imported_manifest"
        end
    end
    if test -r "$imported_manifest"
        if test -e devenv.nix; and command -q devenv
            devenv print-dev-env --shell fish >/dev/null 2>&1; or begin
                rm -rf .devenv
                rm -f "$imported_manifest"
            end
        end
        if test -r "$imported_manifest"
            .devenv/profile/bin/aube check >/dev/null 2>&1; or begin
                find . -maxdepth 3 -name node_modules -type d -prune -exec rm -rf -- {} +
                rm -f "$imported_manifest"
            end
        end
    end

    set -l wrapper ""
    if test -r "$imported_manifest"; and test -d node_modules/.bin; and not test -e node_modules/.bin/aube
        set wrapper node_modules/.bin/aube
        ln -s "$HOME/.local/bin/herdr-sandbox-fish" "$wrapper"
    end

    set -l setup_done "$state_dir/setup-done"
    if not test -e "$setup_done"
        if test -x .agents/setup
            .agents/setup; or begin
                test -n "$wrapper"; and rm -f "$wrapper"
                exit 1
            end
        end
        touch "$setup_done"
    end
    test -n "$wrapper"; and rm -f "$wrapper"

    set -l boot_id (cat /proc/sys/kernel/random/boot_id 2>/dev/null)
    if test -n "$boot_id"; and test "$boot_id" != "$(cat $state_dir/resume-boot 2>/dev/null)"
        if test -x .agents/resume
            .agents/resume; or exit 1
        end
        printf '%s' "$boot_id" >"$state_dir/resume-boot"
    end

    if test -e devenv.nix; and command -q devenv
        set -l temporary_environment "$state_dir/devenv-environment.fish."(random)
        devenv print-dev-env --shell fish >"$temporary_environment"; or exit 1
        mv -f "$temporary_environment" "$state_dir/devenv-environment.fish"
    else
        rm -f "$state_dir/devenv-environment.fish"
    end
    if test -n "$HERDR_DEVENV_CACHE_FINGERPRINT"; and test -d .devenv
        printf '%s\n' "$HERDR_DEVENV_CACHE_FINGERPRINT" >.devenv/.herdr-sandbox-devenv-v3
    end
    if test -n "$HERDR_DEPENDENCY_CACHE_FINGERPRINT"; and test -d node_modules
        printf '%s\n' "$HERDR_DEPENDENCY_CACHE_FINGERPRINT" >node_modules/.herdr-sandbox-dependencies-v3
    end
    exit 0
end

# One preparation transaction owns cache validation and lifecycle hooks.
/usr/bin/flock "$state_dir/project-provision.lock" \
    "$HERDR_HOST_PROFILE/bin/fish" \
    /home/agent/.local/bin/herdr-sandbox-fish provision-locked
or exit 1
if test "$mode" = prepare
    exit 0
end

cd "$HERDR_CHECKOUT"; or exit 1
set -l escaped_credential_token (string escape -- "$HERDR_SANDBOX_CREDENTIAL_TOKEN")
set -l escaped_proxy_ca_bundle (string escape -- "$proxy_ca_bundle")
set -l startup_command "set -gx SSL_CERT_FILE $escaped_proxy_ca_bundle; set -gx NIX_SSL_CERT_FILE $escaped_proxy_ca_bundle; set -gx NODE_EXTRA_CA_CERTS $escaped_proxy_ca_bundle; test -r $state_dir/devenv-environment.fish; and source $state_dir/devenv-environment.fish; set -gx SUPERMEMORY_API_KEY $escaped_credential_token; set -gx SUPERMEMORY_API_URL http://127.0.0.1:$HERDR_SANDBOX_EGRESS_PORT/supermemory; set -gx SUPERMEMORY_BASE_URL http://127.0.0.1:$HERDR_SANDBOX_EGRESS_PORT/supermemory; source $HOME/.local/lib/herdr-sandbox/remap-session-home.fish"
exec "$HERDR_HOST_PROFILE/bin/fish" -l -C "$startup_command"
