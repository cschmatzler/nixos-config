#!/usr/bin/env fish

set -l encoded_environment "$argv[1]"
set -l host_profile "$argv[2]"
set -l mode "$argv[3]"
if test -z "$mode"
    set mode attach
end
if not string match -qr '^[A-Za-z0-9+/=]{1,32768}$' -- "$encoded_environment"; or \
        not string match -qr '^/nix/store/[a-z0-9]{32}-[^/]+$' -- "$host_profile"; or \
        not contains -- "$mode" attach prepare
    echo "[herdr-sandbox] invalid pane environment selector" >&2
    exit 2
end

set -gx HOME /home/agent
set -gx HERDR_HOST_PROFILE "$host_profile"
ln -sfn "$HERDR_HOST_PROFILE" "$HOME/.nix-profile" 2>/dev/null
set -l jq "$HOME/.nix-profile/bin/jq"
set -l base64 "$HOME/.nix-profile/bin/base64"
if not test -x "$jq"; or not test -x "$base64"
    echo "[herdr-sandbox] pane environment tools are unavailable" >&2
    exit 1
end
set -l environment_json (printf '%s' "$encoded_environment" | "$base64" --decode 2>/dev/null | string collect)
set -l allowed_keys \
    COLORTERM \
    HERDR_CHECKOUT \
    HERDR_DEPENDENCY_CACHE_FINGERPRINT \
    HERDR_DEVENV_CACHE_FINGERPRINT \
    HERDR_ENV \
    HERDR_HOST_HOME \
    HERDR_HOST_HOME_FILES \
    HERDR_HOST_NAME \
    HERDR_HOST_PROFILE \
    HERDR_NIX \
    HERDR_PANE_ID \
    HERDR_REPO_ROOT \
    HERDR_SANDBOX_BROKER_PORT \
    HERDR_SANDBOX_CREDENTIAL_TOKEN \
    HERDR_SANDBOX_EGRESS_PORT \
    HERDR_TAB_ID \
    HERDR_WORKSPACE_ID \
    LANG \
    TERM
set -l expected_keys (printf '%s\n' $allowed_keys | sort | "$jq" -Rsc 'split("\n")[:-1]')
printf '%s' "$environment_json" | "$jq" -e \
    --argjson expected "$expected_keys" \
    'type == "object" and (keys == $expected) and all(.[]; type == "string")' \
    >/dev/null
or begin
    echo "[herdr-sandbox] pane environment is invalid" >&2
    exit 1
end

for entry in (printf '%s' "$environment_json" | "$jq" -r 'to_entries[] | [.key, .value] | @tsv')
    set -l fields (string split -m 1 \t -- "$entry")
    if test (count $fields) -ne 2; or not contains -- "$fields[1]" $allowed_keys
        echo "[herdr-sandbox] pane environment is invalid" >&2
        exit 1
    end
    set -gx $fields[1] "$fields[2]"
end
if test "$HERDR_HOST_PROFILE" != "$host_profile"; or \
        not string match -qr '^[A-Za-z0-9:_-]+$' -- "$HERDR_PANE_ID"; or \
        not string match -qr '^/home/' -- "$HERDR_CHECKOUT"; or \
        not string match -qr '^[a-f0-9]{64}$' -- "$HERDR_DEVENV_CACHE_FINGERPRINT"; or \
        not string match -qr '^[a-f0-9]{64}$' -- "$HERDR_DEPENDENCY_CACHE_FINGERPRINT"
    echo "[herdr-sandbox] pane environment contains invalid values" >&2
    exit 1
end

exec "$HERDR_HOST_PROFILE/bin/fish" /home/agent/.local/bin/herdr-sandbox-fish "$mode"
