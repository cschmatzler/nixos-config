#!/usr/bin/env fish

set -gx HOME /home/agent
ln -sfn "$HERDR_HOST_PROFILE" "$HOME/.nix-profile"
set -gx PATH (dirname "$HERDR_NIX") "$HOME/.nix-profile/bin" $PATH

set -l state_dir "$HOME/.local/state/herdr-sandbox"
mkdir -p "$state_dir"

# Bind-mount the private clone at the worktree checkout. Mounts do not survive
# sandbox restarts, so this re-checks on every attach; the check itself is free.
if test -n "$HERDR_CHECKOUT"; and not mountpoint -q "$HERDR_CHECKOUT"
    sudo -n sh -ceu '
        checkout=$1
        repo_root=$2
        mkdir -p "$(dirname "$checkout")"
        if test -L "$checkout"; then
            rm "$checkout"
        fi
        mkdir -p "$checkout"
        mountpoint -q "$checkout" || mount --bind "$repo_root" "$checkout"
    ' sh "$HERDR_CHECKOUT" "$HERDR_REPO_ROOT"; or begin
        echo "[herdr-sandbox] failed to mount the workspace checkout" >&2
        exit 1
    end
end
if test -n "$HERDR_CHECKOUT"
    cd "$HERDR_CHECKOUT"; or exit 1
end

# Mirror the Home Manager generation once per generation, not per pane.
if test -d "$HERDR_HOST_HOME_FILES"; and test "$HERDR_HOST_HOME_FILES" != "$(cat $state_dir/home-files 2>/dev/null)"
    for relative in (find "$HERDR_HOST_HOME_FILES" -mindepth 1 -not -type d -printf '%P\0' | string split0)
        set -l target "$HOME/$relative"
        mkdir -p (dirname "$target")
        ln -sfn "$HERDR_HOST_HOME_FILES/$relative" "$target"
    end
    printf '%s' "$HERDR_HOST_HOME_FILES" >"$state_dir/home-files"
end

mkdir -p "$HOME/.pi/agent" "$HOME/.config/herdr"
for cache in .pi/agent/npm .pi/agent/git
    set -l source "$HERDR_HOST_HOME/$cache"
    set -l target "$HOME/$cache"
    if test -d "$source"; and not test -e "$target"
        mkdir -p (dirname "$target")
        ln -s "$source" "$target"
    end
end

set -gx HERDR_SOCKET_PATH "$HOME/.config/herdr/herdr.sock"
set -l relay_state "$state_dir/relay"
mkdir -p "$relay_state"
set -l relay_pid (cat "$relay_state/pid" 2>/dev/null)
set -l relay_token (cat "$relay_state/token" 2>/dev/null)
if test "$relay_token" != "$HERDR_SANDBOX_TOKEN"; or \
        not kill -0 "$relay_pid" 2>/dev/null
    kill "$relay_pid" 2>/dev/null
    printf '%s' "$HERDR_SANDBOX_TOKEN" >"$relay_state/token"
    chmod 600 "$relay_state/token"
    rm -f "$HERDR_SOCKET_PATH"
    nohup node "$HOME/.local/lib/herdr-sandbox/herdr-relay.mjs" \
        >"$relay_state/log" 2>&1 &
    echo $last_pid >"$relay_state/pid"
end

if test -d "$HERDR_HOST_HOME/.cache/ms-playwright"
    set -gx PLAYWRIGHT_BROWSERS_PATH "$HOME/.cache/ms-playwright"
    set -gx PLAYWRIGHT_SKIP_BROWSER_GC 1
    mkdir -p "$PLAYWRIGHT_BROWSERS_PATH"
    for browser in "$HERDR_HOST_HOME/.cache/ms-playwright"/*
        set -l target "$PLAYWRIGHT_BROWSERS_PATH/"(basename "$browser")
        test -e "$target"; or ln -s "$browser" "$target"
    end
end

# Project provisioning runs once per sandbox boot; later panes attach directly.
set -l boot_id (cat /proc/sys/kernel/random/boot_id 2>/dev/null)
if test -n "$boot_id"; and test "$boot_id" != "$(cat $state_dir/provision-boot 2>/dev/null)"
    for _attempt in (seq 60)
        pgrep -x apt-get >/dev/null; or break
        sleep 1
    end

    if test -x .agents/resume
        if not .agents/resume
            if test -x .agents/setup
                echo "[herdr-sandbox] resume failed; running .agents/setup"
                .agents/setup; or exit 1
            end
        end
    else if test -x .agents/setup
        .agents/setup; or exit 1
    end
    printf '%s' "$boot_id" >"$state_dir/provision-boot"
end

set -l startup_command "source $HOME/.local/lib/herdr-sandbox/remap-session-home.fish"
if set -q SSL_CERT_FILE
    set startup_command "set -gx SSL_CERT_FILE "(string escape -- "$SSL_CERT_FILE")"; $startup_command"
end
exec "$HERDR_HOST_PROFILE/bin/fish" -l -C "$startup_command"
