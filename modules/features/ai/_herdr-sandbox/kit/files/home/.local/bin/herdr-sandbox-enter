#!/usr/bin/env bash
set -u

unset ANTHROPIC_API_KEY OPENAI_API_KEY OPENROUTER_API_KEY NEBIUS_API_KEY \
  XAI_API_KEY MISTRAL_API_KEY GOOGLE_API_KEY SBX_CRED_ANTHROPIC_MODE

ln -sfn "$HERDR_HOST_PROFILE" "$HOME/.nix-profile"
export PATH="$HOME/.nix-profile/bin:$PATH"

runtime_dir="/run/user/$(id -u)"
if [[ ! -w "$runtime_dir" ]]; then
  sudo mkdir -p "$runtime_dir"
  sudo chown "$(id -u):$(id -g)" "$runtime_dir"
  sudo chmod 700 "$runtime_dir"
fi
export XDG_RUNTIME_DIR="$runtime_dir"

host_system=$(readlink -f /nix/var/nix/profiles/system 2>/dev/null || true)
if [[ -n "$host_system" ]]; then
  # The host fish config prepends /run/wrappers/bin and
  # /run/current-system/sw/bin; recreate both so the system profile's tools
  # resolve while Ubuntu's setuid sudo still shadows the non-setuid Nix one.
  sudo sh -c "ln -sfn '$host_system' /run/current-system &&
    mkdir -p /run/wrappers/bin &&
    ln -sfn '$HOME/.local/bin/herdr-sandbox-sudo' /run/wrappers/bin/sudo"
  export PATH="/run/wrappers/bin:$PATH:/run/current-system/sw/bin"
fi

host_workspace_cwd="$PWD"
case "$host_workspace_cwd" in
  "$HERDR_HOST_WORKSPACE_ROOT" | "$HERDR_HOST_WORKSPACE_ROOT"/*) ;;
  *) host_workspace_cwd="$HERDR_HOST_WORKSPACE_ROOT" ;;
esac
if ! mountpoint -q "$HERDR_WORKSPACE_ROOT"; then
  sudo mkdir -p "$HERDR_WORKSPACE_ROOT"
  sudo mount --bind "$HERDR_HOST_WORKSPACE_ROOT" "$HERDR_WORKSPACE_ROOT"
fi
if [[ "$(hostname)" != "$HERDR_SANDBOX_HOSTNAME" ]] ||
  ! getent hosts "$HERDR_SANDBOX_HOSTNAME" >/dev/null 2>&1; then
  sudo sh -eu -c '
    hosts=/run/herdr-sandbox-hosts
    cp /etc/hosts "$hosts.new"
    printf "127.0.1.1 %s\n" "$1" >>"$hosts.new"
    mv "$hosts.new" "$hosts"
    mount --bind "$hosts" /etc/hosts
    hostname "$1"
  ' sh "$HERDR_SANDBOX_HOSTNAME"
fi

mirror_home_files() {
  src="$1"
  [[ -n "$src" && -d "$src" ]] || return 0
  while IFS= read -r -d '' rel; do
    mkdir -p "$HOME/$(dirname "$rel")"
    ln -sfn "$src/$rel" "$HOME/$rel"
  done < <(cd "$src" && find . -mindepth 1 -not -type d -printf '%P\0')
}
mirror_home_files "${HERDR_HOST_HOME_FILES:-}"

mkdir -p "$HOME/.pi/agent" "$HOME/.config/herdr"
for entry in .pi/agent/npm .pi/agent/git; do
  [[ -d "$HOME/$entry" && ! -L "$HOME/$entry" ]] ||
    ln -sfn "$HERDR_HOST_HOME/$entry" "$HOME/$entry"
done

host_playwright_cache="$HERDR_HOST_HOME/.cache/ms-playwright"
guest_playwright_cache="$HOME/.cache/ms-playwright"
mkdir -p "$guest_playwright_cache"
if [[ -d "$host_playwright_cache" ]]; then
  for browser in "$host_playwright_cache"/*; do
    [[ -d "$browser" ]] || continue
    target="$guest_playwright_cache/$(basename "$browser")"
    if [[ -L "$target" && ! -e "$target" ]]; then rm -f "$target"; fi
    [[ -e "$target" || -L "$target" ]] || ln -s "$browser" "$target"
  done
fi
export PLAYWRIGHT_BROWSERS_PATH="$guest_playwright_cache"
export PLAYWRIGHT_SKIP_BROWSER_GC=1

state="$HOME/.local/state/herdr-sandbox"
relay="$state/relay"
socket="$HOME/.config/herdr/herdr.sock"
export HERDR_SOCKET_PATH="$socket"
mkdir -p "$relay"

relay_pid=$(cat "$relay/pid" 2>/dev/null)
if [[ "$(cat "$relay/token" 2>/dev/null)" != "$HERDR_SANDBOX_TOKEN" ]] ||
  ! kill -0 "$relay_pid" 2>/dev/null; then
  kill "$relay_pid" 2>/dev/null
  printf %s "$HERDR_SANDBOX_TOKEN" >"$relay/token"
  chmod 600 "$relay/token"
  rm -f "$socket"
  nohup node "$HOME/.local/lib/herdr-sandbox/herdr-relay.mjs" >"$relay/log" 2>&1 &
  echo $! >"$relay/pid"
  for _ in $(seq 1 100); do [[ -S $socket ]] && break; sleep 0.05; done
fi

aube_wrapper=""
if [[ "${HERDR_DEPENDENCY_CACHE_REUSED:-}" == 1 &&
  -d "$HERDR_WORKSPACE_ROOT/node_modules/.bin" &&
  ! -e "$HERDR_WORKSPACE_ROOT/node_modules/.bin/aube" ]]; then
  aube_wrapper="$HERDR_WORKSPACE_ROOT/node_modules/.bin/aube"
  ln -s "$HOME/.local/bin/herdr-sandbox-aube" "$aube_wrapper"
fi

boot=$(cat /proc/sys/kernel/random/boot_id)
boot_marker="$state/boot-$boot"
lifecycle_status=0
if mkdir "$boot_marker" 2>/dev/null; then
  if [[ -e "$state/setup-done" ]]; then
    if [[ -x "$HERDR_WORKSPACE_ROOT/.agents/resume" ]]; then
      (cd "$HERDR_WORKSPACE_ROOT" && .agents/resume)
      lifecycle_status=$?
      if ((lifecycle_status != 0)); then
        echo "[herdr-sandbox] .agents/resume failed; continuing." >&2
      fi
    fi
  else
    if [[ -x "$HERDR_WORKSPACE_ROOT/.agents/setup" ]]; then
      (cd "$HERDR_WORKSPACE_ROOT" && .agents/setup)
      lifecycle_status=$?
      if ((lifecycle_status != 0)); then
        echo "[herdr-sandbox] .agents/setup failed; continuing." >&2
      fi
    fi
    if ((lifecycle_status == 0)); then touch "$state/setup-done"; fi
  fi
  if ((lifecycle_status != 0)); then rmdir "$boot_marker"; fi
fi
if [[ -n "$aube_wrapper" && -L "$aube_wrapper" ]]; then rm -f "$aube_wrapper"; fi

devenv_status=0
if [[ -e "$HERDR_WORKSPACE_ROOT/devenv.nix" ]] && command -v devenv >/dev/null 2>&1; then
  if devenv_environment=$(cd "$HERDR_WORKSPACE_ROOT" && devenv print-dev-env); then
    eval "$devenv_environment"
  else
    devenv_status=1
    echo "[herdr-sandbox] failed to activate the cached devenv environment; continuing." >&2
  fi
fi
write_cache_marker() {
  cache_dir="$1"
  marker="$2"
  fingerprint="$3"
  [[ -d "$cache_dir" && -n "$fingerprint" ]] || return 0
  printf '%s\n' "$fingerprint" >"$marker.$$"
  mv -f "$marker.$$" "$marker"
}
if ((lifecycle_status == 0 && devenv_status == 0)); then
  write_cache_marker "$HERDR_WORKSPACE_ROOT/.devenv" \
    "$HERDR_WORKSPACE_ROOT/.devenv/.herdr-sandbox-devenv-v2" "${HERDR_DEVENV_CACHE_FINGERPRINT:-}"
  write_cache_marker "$HERDR_WORKSPACE_ROOT/node_modules" \
    "$HERDR_WORKSPACE_ROOT/node_modules/.herdr-sandbox-dependencies-v2" "${HERDR_DEPENDENCY_CACHE_FINGERPRINT:-}"
fi
cd "$host_workspace_cwd" 2>/dev/null || cd "$HERDR_HOST_WORKSPACE_ROOT" || exit

exec fish -l -C "source $HOME/.local/lib/herdr-sandbox/remap-session-home.fish"
