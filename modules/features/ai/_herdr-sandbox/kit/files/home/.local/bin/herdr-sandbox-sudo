#!/usr/bin/env bash
set -u

if [[ -e /etc/herdr-playwright-deps-v1 &&
  "$#" -eq 4 &&
  "$1" == -- &&
  "$2" == sh &&
  "$3" == -c &&
  "$4" == "apt-get update&& apt-get install -y --no-install-recommends "* ]]; then
  echo "[herdr-sandbox] Playwright system dependencies are provided by the sandbox kit."
  exit 0
fi

echo "[herdr-sandbox] sudo is unavailable inside the workspace sandbox." >&2
exit 126
